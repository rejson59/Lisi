# Gemini API Key (pobierz z https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase (pobierz z https://supabase.com/dashboard)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Opcjonalne: ElevenLabs API Key (dla lepszego TTS - darmowy tier dostępny)
ELEVENLABS_API_KEY=your_elevenlabs_key_here
